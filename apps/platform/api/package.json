{
  "name": "@postey/platform-api",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 6011 --persist-to ../../../.wrangler-state",
    "build": "wrangler deploy --dry-run --outdir dist",
    "type-check": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply postey-db-dev --local --persist-to ../../../.wrangler-state",
    "clean": "rimraf node_modules .turbo dist .wrangler"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.2",
    "@postey/shared": "*",
    "hono": "^4.6.14",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "typescript": "~5.9.3",
    "wrangler": "^4.107.1"
  }
}
