{
  "name": "postey",
  "private": true,
  "version": "0.0.15",
  "packageManager": "bun@1.3.14",
  "description": "Postey - Self-hosted transactional email & newsletters on Cloudflare",
  "workspaces": [
    "apps/home/*",
    "apps/platform/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run kill-ports; turbo run dev",
    "kill-ports": "kill -9 $(lsof -ti :6010,:6011,:6012,:6013,:6014) 2>/dev/null; echo 'Ports 6010-6014 cleared'",
    "build": "turbo run build",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"apps/**/src/**/*.{ts,tsx}\"",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "release:build": "node installer/build-release.mjs",
    "release:upload": "node installer/upload-release.mjs"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "turbo": "^2.5.4",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20"
  }
}
